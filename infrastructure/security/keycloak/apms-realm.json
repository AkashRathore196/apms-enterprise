{
  "realm": "apms",
  "enabled": true,
  "clients": [
    {
      "clientId": "mdm-test-client",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "mdm-service-client",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["profile", "email", "roles", "web-origins"]
    }
  ],
  "roles": {
    "realm": [
      {"name": "mdm_operator"},
      {"name": "mdm_reader"},
      {"name": "mdm_service"}
    ]
  },
  "clientScopeMappings": {
    "mdm-service-client": {
      "realm": [
        {"name": "mdm_service"}
      ]
    }
  }
}
